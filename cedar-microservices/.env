CEDAR_DOCKER_VERSION=2.8.0

# =============================================================================
# Build image env vars (used by build-all-images.sh and by docker-compose when
# building cedar-microservice). docker-compose uses Stanford defaults. Uncomment to override.
# =============================================================================
# CEDAR_MAVEN_REPO_URL=https://nexus.bmir.stanford.edu
# CEDAR_MAVEN_SNAPSHOTS_URL=https://nexus.bmir.stanford.edu/repository/snapshots
# CEDAR_MAVEN_RELEASES_URL=https://nexus.bmir.stanford.edu/repository/releases
# CEDAR_NEXUS_USERNAME=
# CEDAR_NEXUS_PASSWORD=
# CEDAR_NPM_REGISTRY=https://nexus.bmir.stanford.edu/repository/npm-cedar
